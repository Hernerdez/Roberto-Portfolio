# Copy to .env.local for local dev; set the same names in the Vercel project.
# Never commit real values. Walkthroughs for each token are in the README
# section "Live widgets".

# Spotify (app owner needs Spotify Premium; scopes: user-read-currently-playing user-read-recently-played)
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REFRESH_TOKEN=

# Strava (scope: activity:read_all)
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
STRAVA_REFRESH_TOKEN=

# GitHub fine-grained PAT, public repos read-only, no permissions
GITHUB_TOKEN=

# Homelab status service (services/homelab-status) exposed via Pangolin
HOMELAB_STATUS_URL=https://status.example.com
HOMELAB_STATUS_TOKEN=

# Existing: EmailJS (client-side)
NEXT_PUBLIC_EMAILJS_SERVICE_ID=
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=
